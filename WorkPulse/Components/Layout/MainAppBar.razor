@using System.Globalization;
@using System.Security.Claims
@using System.Timers;
@using MudBlazor
@using WorkPulse.Interfaces

@implements IDisposable
@inject IUserContext UserContext

<MudAppBar Elevation="1">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="DrawerToggle" />
    <MudText Typo="Typo.h6" Class="ml-3">WorkPulse</MudText>
    <div class="d-flex flex-row justify-content-center align-items-center ps-2">
        <MudIconButton Icon="@Icons.Material.Filled.AccessTime" Color="Color.Inherit" />
        <MudText Typo="Typo.h6">@this.currentTime.ToString("HH:mm:ss") - @this.currentTime.ToString("dddd", CultureInfo.CurrentCulture)</MudText>
    </div>
    <MudSpacer />
    <div class="d-flex flex-row justify-content-center align-items-center gap-1">
        <MudText Typo="Typo.h6">@this.UserName</MudText>
        <MudAvatar class="text-white border-white" Variant="Variant.Outlined">@this.GetShortName()</MudAvatar>
    </div>
</MudAppBar>

@code {
    private string UserName => this.UserContext?.User?.Identity?.Name!;
    private DateTime currentTime = DateTime.Now;
    private Timer? timer;

    [Parameter]
    public EventCallback OnDrawerToggle { get; set; }

    protected override void OnInitialized()
    {
        this.timer = new System.Timers.Timer(1000);

        this.timer.Elapsed += (sender, e) =>
        {
            this.currentTime = DateTime.Now; 

            InvokeAsync(StateHasChanged);
        };

        this.timer.Enabled = true; 
    }

    private string GetShortName()
    {
        int monkey = this.UserName?.IndexOf("@") ?? -1;

        if (monkey <= 0) return "U";

        return $"{this.UserName![0]}{this.UserName[monkey - 1]}".ToUpper();
    }

    private async Task DrawerToggle()
    {
        if (OnDrawerToggle.HasDelegate)
        {
            await OnDrawerToggle.InvokeAsync();
        }
    }

    public void Dispose()
    {
        this.timer?.Dispose();
    }
}
