@using Azure.API.Services.Interfaces
@using Azure.API.Utils
@using Azure.API.Models.WorkItems.Requests
@using Azure.API.Models.WorkItems.Responses
@using Azure.API.Models.Profiles

@inject IWorkItemService WiService
@inject IAzureBoardService BoardService
@inject IProfileService ProfileService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (isLoading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (request != null)
        {
            <EditForm @ref="editForm" Model="this.request">
                <DataAnnotationsValidator />
                
                <MudTextField T="string" Label="Title" @bind-Value="this.request.Title" For="@(() => this.request.Title)" Required="true" />
                <MudTextField T="string" Label="Description" @bind-Value="this.request.Description" For="@(() => this.request.Description)" Lines="3" />               
                <MudSelect T="string" @bind-Value="this.request.AssignedTo" Label="Select user profile" Variant="Variant.Outlined">
                    @if (this.profiles?.Count > 0)
                    {
                        @foreach (var p in profiles)
                        {
                            <MudSelectItem T="string" Value="@p.DisplayName">@p.DisplayName</MudSelectItem>
                        }
                    }
                    else
                    {
                        <MudSelectItem T="string" Value="@((string?)null)" Disabled="true">No users</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="int?" Label="Priority" @bind-Value="this.request.Priority" For="@(() => this.request.Priority)" Min="1" Max="4" />
                <MudTextField T="string" Label="Tags" @bind-Value="this.request.Tags" For="@(() => this.request.Tags)" />
                
                <MudGrid Class="mt-2">
                    <MudItem xs="6">
                         <MudSelect T="string" Label="Select Area" Value="selectedArea" ValueChanged="OnAreaChanged" Clearable="true" Variant="Variant.Outlined">
                            @foreach (var area in areaNodes)
                            {
                                <MudSelectItem Value="@area">@area</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" />
                </MudGrid>

                <MudGrid Class="mt-2">
                    <MudItem xs="6">
                         <MudSelect T="string" Label="Select Iteration" Value="selectedIteration" ValueChanged="OnIterationChanged" Clearable="true" Variant="Variant.Outlined">
                            @foreach (var iter in iterationNodes)
                            {
                                <MudSelectItem Value="@iter">@iter</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" />
                </MudGrid>

            </EditForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="Submit" Disabled="@(this.isLoading || this.isSubmitting)">
            Save Changes
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool isLoading = true;
    private bool isSubmitting = false;

    private EditForm editForm;
    private WorkItemRequest request = new WorkItemRequest();
    private List<Profile> profiles = new();
    
    private List<string> areaNodes = new();
    private List<string> iterationNodes = new();
    private string? selectedArea;
    private string? selectedIteration;

    [CascadingParameter] 
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] 
    public int WorkItemId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var t1 = BoardService.GetClassificationNodesAsync("Areas");
            var t2 = BoardService.GetClassificationNodesAsync("Iterations");
            var tWi = WiService.GetWorkItemInfoAsync(WorkItemId);
            
            await Task.WhenAll(t1, t2, tWi);
            
            areaNodes = t1.Result;
            iterationNodes = t2.Result;
            WorkItemResponse existingData = tWi.Result;

            this.request.Title = existingData.Fields.GetValueOrDefault("System.Title")?.ToString() ?? string.Empty;
            this.request.Description = HtmlUtils.GetPlainText(existingData.Fields.GetValueOrDefault("System.Description")?.ToString() ?? string.Empty);
            this.request.AssignedTo = HtmlUtils.GetDisplayName(existingData.Fields.GetValueOrDefault("System.AssignedTo")?.ToString());

            if (existingData.Fields.TryGetValue("Microsoft.VSTS.Common.Priority", out var priorityObj) && int.TryParse(priorityObj?.ToString(), out var priority))
            {
                this.request.Priority = priority;
            }      
            else
            {
                this.request.Priority = null;
            }
           
            this.request.Tags = existingData.Fields.GetValueOrDefault("System.Tags")?.ToString();
            this.request.AreaPath = existingData.Fields.GetValueOrDefault("System.AreaPath")?.ToString();
            this.request.IterationPath = existingData.Fields.GetValueOrDefault("System.IterationPath")?.ToString();

            // Set initial select values if they match loaded nodes
            if (!string.IsNullOrEmpty(this.request.AreaPath) && areaNodes.Contains(this.request.AreaPath))
            {
                selectedArea = this.request.AreaPath;
            }
            if (!string.IsNullOrEmpty(this.request.IterationPath) && iterationNodes.Contains(this.request.IterationPath))
            {
                selectedIteration = this.request.IterationPath;
            }

            try
            {
                ProfileList list = await this.ProfileService.GetUserProfilesAsync();
                if (list?.Profiles != null)
                    this.profiles = list.Profiles;
            }
            catch (Exception ex)
            {
                this.Snackbar.Add($"Unable to load user profiles: {ex.Message}", Severity.Warning);
            }
        }
        catch (Exception)
        {
            this.Snackbar.Add("Failed to load work item data.", Severity.Error);
            this.MudDialog.Cancel(); 
        }
        finally
        {
            this.isLoading = false;
        }
    }

    private void OnAreaChanged(string value)
    {
        selectedArea = value;
        this.request.AreaPath = string.IsNullOrEmpty(value) ? null : value;
    }

    private void OnIterationChanged(string value)
    {
        selectedIteration = value;
        this.request.IterationPath = string.IsNullOrEmpty(value) ? null : value;
    }

    private async Task Submit()
    {
         if (editForm.EditContext.Validate())
        {
            await this.HandleValidSubmit();
        }
        else
        {
            this.HandleInvalidSubmit();
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            this.isSubmitting = true;
            await WiService.UpdateWorkItemAsync(this.WorkItemId, this.request);
            
            this.MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            this.Snackbar.Add($"Error updating: {ex.Message}", Severity.Error);
        }
        finally
        {
            this.isSubmitting = false;
        }
    }

    private void HandleInvalidSubmit() 
        => this.Snackbar.Add("Please correct the errors in the form.", Severity.Warning);

    private void Cancel() => this.MudDialog.Cancel();
}