@using System.Net.Http.Json
@using Azure.API.Services
@using Azure.API.WorkItems.Responses
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web

@inject WorkItemService wiService
@attribute [Authorize]

@page "/"

<PageTitle>WorkItem's dashboard</PageTitle>

@if (Elements?.Value != null)
{
    <MudTable Items="@Elements.Value" MultiSelection="true" Dense="@dense" Hover="@hover" Bordered="@bordered" Striped="@striped" Filter="(wi) => FilterFunc(wi, searchString1)" @bind-SelectedItem="selectedItem1" @bind-SelectedItems="selectedItems" @bind-SortLabel="sortLabel" @bind-SortDirection="sortDirection">
        <ToolBarContent>
            <MudText Typo="Typo.h6">WorkItems</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="searchString1" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh Sortable="true"><MudTableSortLabel T="WorkItemResponse" SortLabel="Id" SortDirection="@sortDirection">Id</MudTableSortLabel></MudTh>
            <MudTh Sortable="true"><MudTableSortLabel T="WorkItemResponse" SortLabel="Title" SortDirection="@sortDirection">Title</MudTableSortLabel></MudTh>
            <MudTh Sortable="true"><MudTableSortLabel T="WorkItemResponse" SortLabel="WorkItemType" SortDirection="@sortDirection">WorkItemType</MudTableSortLabel></MudTh>
            <MudTh Sortable="true"><MudTableSortLabel T="WorkItemResponse" SortLabel="Description" SortDirection="@sortDirection">Description</MudTableSortLabel></MudTh>
            <MudTh Sortable="true"><MudTableSortLabel T="WorkItemResponse" SortLabel="Rev" SortDirection="@sortDirection">Rev</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Title">@(context.Fields.GetValueOrDefault("System.Title")?.ToString() ?? "N/A")</MudTd>
            <MudTd DataLabel="WorkItemType">@(context.Fields.GetValueOrDefault("System.WorkItemType")?.ToString() ?? "N/A")</MudTd>
            <MudTd DataLabel="Description">@(context.Fields.GetValueOrDefault("System.Description")?.ToString() ?? "N/A")</MudTd>
            <MudTd DataLabel="Rev">@context.Rev</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
}
else
{
    <MudText>Loading work items...</MudText>
}

<div class="d-flex flex-wrap mt-4">
    <MudSwitch @bind-Value="hover" Color="Color.Primary">Hover</MudSwitch>
    <MudSwitch @bind-Value="dense" Color="Color.Secondary">Dense</MudSwitch>
    <MudSwitch @bind-Value="striped" Color="Color.Tertiary">Striped</MudSwitch>
    <MudSwitch @bind-Value="bordered" Color="Color.Warning">Bordered</MudSwitch>
    <MudSpacer />
    <div style="min-width:200px;">
        <MudText Class="align-self-center d-inline">Selected1: @(selectedItem1?.Fields.GetValueOrDefault("System.Title")?.ToString() ?? "None")</MudText>
    </div>
</div>

@code {
    private bool dense = false;
    private bool hover = true;
    private bool striped = false;
    private bool bordered = false;

    private string sortLabel = "";
    private string searchString1 = "";

    private WorkItemResponse? selectedItem1 = null;
    private WorkItemListResponse? Elements;

    private HashSet<WorkItemResponse> selectedItems = new HashSet<WorkItemResponse>();
    private SortDirection sortDirection = SortDirection.None;

    protected override async Task OnInitializedAsync()
    {
        int[] ids = Enumerable.Range(1, 20).ToArray();
        string[] fields = [
            "System.Id",
            "System.Title",
            "System.WorkItemType",
            "System.Description"
        ];

        Elements = await wiService.GetWorkItemListAsync(ids, fields, CancellationToken.None);
    }

    private bool FilterFunc(WorkItemResponse wi, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        // Search in Fields values
        foreach (var field in wi.Fields.Values)
        {
            if (field?.ToString()?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true)
                return true;
        }

        // Search in Id and Rev
        if (wi.Id.ToString().Contains(searchString) || wi.Rev.ToString().Contains(searchString))
            return true;

        return false;
    }
}